---
// The landing page. Its styles and scripts are in public/, and the docs
// load the same tokens.css. The figures are the components that the docs
// use, so the landing page ships no script to draw them.
import Anatomy from "../components/figures/Anatomy.astro";
import Flow from "../components/figures/Flow.astro";
import { grammar, tuple } from "../figures/parts";
import type { ComponentProps } from "astro/types";

type FlowProps = ComponentProps<typeof Flow>;

const formats: FlowProps["from"] = [
  {
    title: "JSON",
    code: [
      [["{ ", "muted"], ['"title"', "attr"], [": ", "muted"], ['"Hello"', "val"], [",", "muted"]],
      ["  ", ['"views"', "attr"], [": ", "muted"], ["42", "val"], [" }", "muted"]],
    ],
  },
  {
    title: "protobuf",
    code: [
      [["message ", "accent"], "Post {"],
      [["  string ", "muted"], ["title", "attr"], [" = 1;", "muted"]],
      ["}"],
    ],
  },
  {
    title: "Go struct",
    code: [
      [["type ", "accent"], "Post ", ["struct", "accent"], " {"],
      [["  Title ", "attr"], ["string", "muted"]],
      ["}"],
    ],
  },
];

const tuples: FlowProps["center"] = {
  title: "tuples",
  rows: [
    [["p-1", "id"], ["#", "muted"], ["title", "attr"], [" = ", "muted"], ['"Hello"', "val"]],
    [["p-1", "id"], ["#", "muted"], ["views", "attr"], [" = ", "muted"], ["42", "val"]],
    [["p-2", "id"], ["#", "muted"], ["title", "attr"], [" = ", "muted"], ['"Hi"', "val"]],
  ],
  sub: ["validate · version"],
};

const backends: FlowProps["to"] = [
  { title: "memory", code: [[["map[path][attr]", "muted"]]], hue: "accent" },
  { title: "filesystem", code: [[["posts/p-1.json", "muted"]]], hue: "accent" },
  { title: "redis", code: [[["HSET … title", "muted"]]], hue: "accent" },
  { title: "sqlite", code: [[["a row per record", "muted"]]], hue: "accent" },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>XDB: Think in tuples</title>
<meta name="description" content="XDB stores data as tuples: a path, an attribute, and a typed value. Read and write them from Go or the CLI. Keep them in memory, files, Redis, or SQLite.">
<link rel="canonical" href="https://xdb.dev/">
<link rel="icon" href="favicon.svg" type="image/svg+xml">

<meta property="og:type" content="website">
<meta property="og:site_name" content="XDB">
<meta property="og:url" content="https://xdb.dev/">
<meta property="og:title" content="XDB: Think in tuples">
<meta property="og:description" content="XDB stores data as tuples: a path, an attribute, and a typed value. Read and write them from Go or the CLI. Keep them in memory, files, Redis, or SQLite.">
<meta property="og:image" content="https://xdb.dev/og.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Think in tuples. Storage is a detail. The tuple xdb://com.example/posts/p-1#author.name = &quot;Ada&quot;, with each part of the URI in its own colour.">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="XDB: Think in tuples">
<meta name="twitter:description" content="XDB stores data as tuples: a path, an attribute, and a typed value. Read and write them from Go or the CLI. Keep them in memory, files, Redis, or SQLite.">
<meta name="twitter:image" content="https://xdb.dev/og.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="tokens.css">
<link rel="stylesheet" href="site.css">
</head>
<body>


<div class="wrap">
  <nav class="top">
    <a class="logo" href="#"><img src="logo.svg" alt="XDB" width="100" height="30"> <span>think in tuples</span></a>
    <ul>
      <li><a href="#demo">Example</a></li>
      <li><a href="#how">How it works</a></li>
      <li><a href="#agents">Agents</a></li>
      <li><a href="#start">Get started</a></li>
      <li><a href="docs/">Docs</a></li>
      <li><a href="https://github.com/xdb-dev/xdb">GitHub</a></li>
    </ul>
  </nav>
</div>

<!-- Overview -->
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">Easy for humans · Exact for agents</span>
      <h1>Think in tuples.<br><span class="underlined">Storage is a detail.</span></h1>
      <p class="lede">XDB stores data as tuples: a path, an attribute, and a typed value. Read and write them from Go or the CLI. Keep them in memory, files, Redis, or SQLite.</p>
      <div class="row">
        <a class="btn" href="#start">Get started</a>
        <a class="btn ghost" href="https://github.com/xdb-dev/xdb">View GitHub</a>
      </div>
      <div class="cmd"><span class="pr">$</span> go install github.com/xdb-dev/xdb/cmd/xdb@latest</div>
    </div>
    <div class="stack">
      <div class="win">
        <div class="tab">go  ·  one tuple</div>
<pre><span class="cm">// A path, an attribute, and a typed value.</span>
t := core.NewTuple(
    <span class="st">"com.example/posts/p-1"</span>, <span class="st">"title"</span>, <span class="st">"Hello"</span>)

t.URI()    <span class="cm">// xdb://</span><span class="p-ns">com.example</span><span class="cm">/</span><span class="p-schema">posts</span><span class="cm">/</span><span class="p-id">p-1</span><span class="cm">#</span><span class="p-attr">title</span>
t.AsStr()  <span class="cm">// "Hello", nil</span>

<span class="cm">// The same call on memory, files, Redis, or SQLite.</span>
err := st.PutTuples(ctx, t)</pre>
      </div>
      <div class="win">
        <div class="tab">shell  ·  the same tuple from the CLI</div>
<pre><span class="pr">$</span> xdb get xdb://com.example/posts/p-1#title
{"{"} "_id": "p-1", …, "title": "Hello" {"}"}</pre>
      </div>
    </div>
  </div>
  <div class="wrap hero-fig">
    <Anatomy
      alt="Anatomy of the URI xdb://com.example/posts/p-1#title = Hello, with namespace, schema, id, attr and value called out."
      label="fig. 0"
      caption="anatomy of a tuple"
      parts={tuple.parts}
      groups={tuple.groups}
      size={30}
    />
  </div>
</section>

<!-- Example -->
<section id="demo">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Example</span>
      <h2>Real sessions, replayed.</h2>
      <p class="lede">The scenarios and the data come from the agent task evals: a store, a household ledger, and an issue tracker. Each command and its output come from a real run of the CLI.</p>
    </div>
    <div class="win term" id="replay">
      <div class="tab">
        <span class="chapters" role="tablist" aria-label="Sessions"></span>
        <span class="ctl"><button type="button" data-toggle hidden>Pause</button><span class="rec">recorded by <code>make site-demo</code></span></span>
      </div>
      <div class="stage" data-state="poster">
        <pre class="screen" aria-hidden="true"></pre>
        <button type="button" class="overlay" aria-label="Play">
          <span class="play" aria-hidden="true"></span>
          <span class="ov-title"></span>
          <span class="ov-meta"></span>
        </button>
      </div>
      <div class="progress" aria-hidden="true"><span></span></div>
      <pre class="transcript sr-only"></pre>
      <noscript><p class="muted small noscript">The replay needs JavaScript. The <a href="docs/start/">get-started guide</a> shows the same commands.</p></noscript>
    </div>
  </div>
</section>

<!-- How it works -->
<section id="how">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">How it works</span>
      <h2>Everything passes through tuples.</h2>
      <p class="lede">Data comes in as JSON, protobuf messages, or Go structs. XDB converts it to tuples, checks them against your schema, and hands them to the driver for your backend. Reads take the same path in reverse.</p>
    </div>
    <Flow
      alt="A JSON document, a protobuf message and a Go struct converge into the same tuples in the middle, which then fan out to drivers for memory, filesystem, Redis and SQLite."
      label="fig. 1"
      caption="formats in, backends out"
      from={formats}
      into="encode"
      center={tuples}
      out="driver"
      to={backends}
    />
    <div class="steps">
      <div class="step"><i>1</i><b>Convert</b><p>The <code>xdbjson</code>, <code>xdbproto</code>, and <code>xdbstruct</code> encoders convert each format to tuples and back.</p></div>
      <div class="step"><i>2</i><b>Check</b><p>The store validates each value against the schema and sets the record version. Every backend gets the same rules.</p></div>
      <div class="step"><i>3</i><b>Write</b><p>The driver for your backend writes the tuples as a map in memory, a JSON file, a Redis hash, or a SQLite row.</p></div>
    </div>
    <div class="row more">
      <a class="btn ghost" href="docs/guides/import-types/">Import your types</a>
      <a class="btn ghost" href="docs/guides/define-a-schema/">Define a schema</a>
      <a class="btn ghost" href="docs/guides/choose-a-backend/">Choose a backend</a>
    </div>
  </div>
</section>

<!-- Agents -->
<section id="agents">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Agents</span>
      <h2>A CLI agents can inspect.</h2>
      <p class="lede">Resource commands follow <code>xdb &lt;resource&gt; &lt;action&gt; &lt;URI&gt; [flags]</code>. Use <code>describe</code> to discover supported actions, payload types, filters, and error codes.</p>
    </div>
    <Anatomy
      alt="The CLI grammar, xdb resource action URI with filter, fields, payload and output flags, each annotated."
      label="fig. 2"
      caption="the grammar"
      parts={grammar}
      size={18}
    />
    <div class="row more"><a class="btn ghost" href="docs/guides/use-with-agents/">Use XDB from an agent</a></div>
  </div>
</section>

<!-- Getting started -->
<section id="start">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Get started</span>
      <h2>Create your first record.</h2>
    </div>
    <div class="steps">
      <div class="step"><i>1</i><b>Install</b><p>Install the Go binary, which includes the CLI and daemon.</p>
<pre>go install github.com/xdb-dev/xdb/cmd/xdb@latest</pre></div>
      <div class="step"><i>2</i><b>Init</b><p>Create the config and start the daemon with SQLite. Select another backend in the config if needed.</p>
<pre>xdb init</pre></div>
      <div class="step"><i>3</i><b>Write</b><p>Define a schema and write a record. Use <code>xdb describe</code> to look up other operations.</p>
<pre>xdb schemas create xdb://com.example/posts \
  --json '{"{"}"fields":{"{"}"title":{"{"}"type":"string"{"}"}{"}"}{"}"}'
xdb records create xdb://com.example/posts/p-1 \
  --json '{"{"}"title":"Hello"{"}"}'</pre></div>
    </div>
    <p class="muted small note">Next: the <a href="docs/start/">get-started guide</a> covers reads and version checks, and <code>xdb context</code> prints the agent guide.</p>
  </div>
</section>

<!-- Guides -->
<section id="guides">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Guides</span>
      <h2>Pick the guide for your task.</h2>
    </div>
    <div class="cards">
      <a class="card" href="docs/guides/define-a-schema/"><h3>Define a schema</h3><p>Declare fields and types, select a validation mode, and add indexes and constraints.</p></a>
      <a class="card" href="docs/guides/import-types/"><h3>Import your types</h3><p>Create a schema from a Go struct, a protobuf message, or a JSON Schema file.</p></a>
      <a class="card" href="docs/guides/read-and-write/"><h3>Read and write records</h3><p>Filters, version checks, dry runs, bulk data, and change streams.</p></a>
      <a class="card" href="docs/guides/choose-a-backend/"><h3>Choose a backend</h3><p>How each driver stores a tuple, and how to select one in the config.</p></a>
      <a class="card" href="docs/guides/use-with-agents/"><h3>Use XDB from an agent</h3><p>Discover the CLI at runtime, parse its errors, and pipe JSON between commands.</p></a>
      <a class="card" href="docs/guides/embed-in-go/"><h3>Embed XDB in Go</h3><p>Build a store in your own service and serve it over JSON-RPC.</p></a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <span><b>xdb</b> · think in tuples</span>
    <span>
      <a href="https://github.com/xdb-dev/xdb">GitHub</a> ·
      <a href="docs/">Docs</a> ·
      <a href="https://raviatluri.in/articles/introducing-xdb">Introducing XDB</a>
    </span>
  </div>
</footer>

<script is:inline src="replay.js"></script>
</body>
</html>
