---
// Anatomy: one line in large mono type, with a callout under each part
// that has a meaning of its own. A bracket over a run of parts names the
// run. Use it when the parts of one line, such as a URI or a command, are
// the map of a section.
//
// In a wide frame, each callout hangs under its part, on one of two rows
// so that two neighbors do not touch. In a narrow frame, the line wraps,
// and the callouts become a legend under it.
import Figure from "./Figure.astro";
import { color, type Hue } from "./hues";

interface Part {
  text: string;
  hue?: Hue;
  // label and sub make the callout of the part.
  label?: string;
  sub?: string;
  // row 1 hangs the callout lower than row 0.
  row?: 0 | 1;
  // over is a muted note above the part.
  over?: string;
  // group puts the part under the bracket of that group.
  group?: string;
}

interface Group {
  id: string;
  label: string;
}

interface Props {
  alt: string;
  caption?: string;
  label?: string;
  parts: Part[];
  groups?: Group[];
  // size is the type size of the line in a wide frame, in pixels.
  size?: number;
}

const { alt, caption, label, parts, groups = [], size = 24 } = Astro.props;

const chars = parts.reduce((n, p) => n + p.text.length, 0);
const rows = parts.some((p) => p.label && p.row === 1) ? 2 : parts.some((p) => p.label) ? 1 : 0;
const top = groups.length > 0 || parts.some((p) => p.over);

// Consecutive parts of one group share a bracket.
type Block = { group?: Group; parts: Part[] };
const blocks: Block[] = [];
for (const part of parts) {
  const group = groups.find((g) => g.id === part.group);
  const last = blocks.at(-1);
  if (group && last?.group === group) last.parts.push(part);
  else blocks.push({ group, parts: [part] });
}

const legend = [
  ...groups.map((g) => ({ label: g.label, sub: "", hue: "ink" as Hue })),
  ...parts.filter((p) => p.label).map((p) => ({ label: p.label!, sub: p.sub ?? "", hue: p.hue ?? "ink" })),
];
---

<Figure alt={alt} caption={caption} label={label}>
  <div
    class:list={["an", `rows-${rows}`, { top }]}
    style={`--size:${size}px;--chars:${chars}`}
  >
    <div class="an-line">
      {
        blocks.map((block) => {
          // Each part stays on one line of markup. The line is white-space:
          // pre, so a line break in the markup would show as a space.
          const spans = block.parts.map((p) => (
            <span class:list={["an-part", { called: p.label }]} style={`--hue:${color(p.hue)}`}>{p.text}{p.over && <span class="an-over">{p.over}</span>}{p.label && <span class:list={["an-call", `row-${p.row ?? 0}`]}><b>{p.label}</b>{p.sub && <span>{p.sub}</span>}</span>}</span>
          ));
          return block.group ? (
            <span class="an-group"><span class="an-glabel">{block.group.label}</span>{spans}</span>
          ) : (
            spans
          );
        })
      }
    </div>
    <ul class="an-legend">
      {
        legend.map((item) => (
          <li style={`--hue:${color(item.hue)}`}>
            <b>{item.label}</b>
            {item.sub && <span>{item.sub}</span>}
          </li>
        ))
      }
    </ul>
  </div>
</Figure>

<style>
  .an {
    padding: 8px 4px 0;
  }
  .an.top {
    padding-top: 58px;
  }
  .an.rows-1 {
    padding-bottom: 64px;
  }
  .an.rows-2 {
    padding-bottom: 116px;
  }
  .an-line {
    display: flex;
    justify-content: center;
    font-family: var(--mono);
    font-weight: 500;
    font-size: min(var(--size), calc(100cqi / (var(--chars) * 0.62)));
    line-height: 1.2;
    white-space: pre;
  }
  .an-part {
    position: relative;
    color: var(--hue);
  }
  /* A part with a callout gets a marker stroke in its hue, under the
     descenders of the letters. */
  .an-part.called {
    z-index: 0;
  }
  .an-part.called::after {
    content: "";
    position: absolute;
    z-index: -1;
    left: -0.04em;
    right: -0.04em;
    bottom: -0.2em;
    height: 0.22em;
    background: var(--hue);
    opacity: 0.35;
    mask: var(--marker) 0 0 / 100% 100% no-repeat;
  }

  /* A callout: a stem from the part, then the label and the sub. */
  .an-call {
    position: absolute;
    left: 50%;
    top: calc(100% + var(--drop));
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--sans);
    font-weight: 400;
    white-space: nowrap;
    line-height: 1.3;
  }
  .an-call.row-0 {
    --drop: 14px;
  }
  .an-call.row-1 {
    --drop: 64px;
  }
  .an-call::before {
    content: "";
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 1.5px;
    height: calc(var(--drop) - 4px);
    margin-bottom: 2px;
    background: var(--hue);
  }
  .an-call b {
    font-size: 15px;
    font-weight: 600;
    color: var(--hue);
  }
  .an-call span {
    font-size: 12px;
    color: var(--muted);
  }

  /* A note above one part, and the bracket over a group of parts. */
  .an-over {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 26px);
    transform: translateX(-50%);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
    white-space: nowrap;
  }
  .an-group {
    position: relative;
  }
  .an-group::before {
    content: "";
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: calc(100% + 6px);
    height: 10px;
    border: 1.5px solid var(--ink);
    border-bottom: 0;
  }
  .an-glabel {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 22px);
    transform: translateX(-50%);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }

  .an-legend {
    display: none;
  }

  @container (max-width: 640px) {
    .an,
    .an.top,
    .an.rows-1,
    .an.rows-2 {
      padding: 0;
    }
    .an-line {
      flex-wrap: wrap;
      justify-content: flex-start;
      font-size: max(13px, min(var(--size), calc(100cqi / (var(--chars) * 0.62))));
      white-space: pre-wrap;
    }
    .an-call,
    .an-over,
    .an-glabel,
    .an-group::before {
      display: none;
    }
    .an-legend {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 10px 18px;
      margin: 18px 0 0;
      padding: 0;
      list-style: none;
    }
    .an-legend li {
      display: flex;
      flex-direction: column;
      padding-left: 10px;
      border-left: 3px solid var(--hue);
    }
    .an-legend b {
      font-size: 14px;
      font-weight: 600;
      color: var(--hue);
    }
    .an-legend span {
      font-size: 12px;
      color: var(--muted);
    }
  }
</style>
