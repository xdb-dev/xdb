---
// A pipe: commands from top to bottom, each one feeding the next. A label
// on each joint says what passes through it. Use it for a shell pipeline,
// or any chain where the output of one step is the input of the next.
import Figure from "./Figure.astro";
import Code from "./Code.astro";
import type { Line } from "./hues";

interface Props {
  alt: string;
  caption?: string;
  label?: string;
  // accent marks the step that the page is about.
  steps: { line: Line; accent?: boolean }[];
  // joints[i] labels the joint between step i and step i + 1.
  joints: string[];
}

const { alt, caption, label, steps, joints } = Astro.props;
---

<Figure alt={alt} caption={caption} label={label}>
  <div class="pp">
    {
      steps.map((step, i) => (
        <>
          <div class:list={["pp-step", { accent: step.accent }]}>
            <Code line={step.line} />
          </div>
          {i < steps.length - 1 && <div class="pp-joint"><span class="pp-arrow" /><span>{joints[i]}</span></div>}
        </>
      ))
    }
  </div>
</Figure>

<style>
  .pp {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pp-step {
    padding: 9px 16px;
    border: 1.5px solid var(--ink);
    background: var(--card, #fff);
    font-size: 13px;
  }
  .pp-step.accent {
    border-color: var(--accent);
    background: #e8ecfb;
  }
  .pp-joint {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-self: stretch;
    align-items: center;
    height: 34px;
    font-size: 12px;
    color: var(--accent);
  }
  .pp-joint span:last-child {
    padding-left: 10px;
  }
  .pp-arrow {
    grid-column: 2;
    position: relative;
    width: 1.5px;
    height: 100%;
    background: var(--accent);
  }
  .pp-arrow::after {
    content: "";
    position: absolute;
    left: -4.25px;
    bottom: 0;
    border: 5px solid transparent;
    border-top: 6px solid var(--accent);
    border-bottom: 0;
  }
</style>
